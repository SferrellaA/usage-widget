#!/usr/bin/env python3
"""Fetch the SuperGrok weekly pool and print a secret-free status record."""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from usage_widget.billing import collect, write_status  # noqa: E402


def main() -> int:
    record = collect()
    try:
        write_status(record)
    except OSError:
        # The bar can still use stdout. A state-dir failure must not hide the reading.
        pass
    sys.stdout.write(json.dumps(record, sort_keys=True) + "\n")
    if record.get("auth") == "signed-out":
        return 2
    if not record.get("ok"):
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
